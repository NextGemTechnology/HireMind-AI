# ============================================================
# TalentIQ / HireMind AI — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL.
# ============================================================

# Spring Environment Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=HireMeAI
MYSQL_USER=talentiq_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP Email Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hiremindai.ai@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_FROM=hiremindai.ai@gmail.com
MAIL_FROM_NAME="HireMind AI Platform"

# Security & JWT Token Secrets (Minimum 256-bit secret in production)
JWT_SECRET=your_ultra_secure_256_bit_jwt_secret_key_here

# AI Service Keys (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
