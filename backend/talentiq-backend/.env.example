# ============================================================
# TalentIQ Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_PROFILE=dev
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentiq_dev
DB_USER=talentiq_user
DB_PASSWORD=your_secure_db_password_here

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random key (min 256 bits / 32 chars)
# Run: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_256_BIT_KEY
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Mail ──────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@talentiq.ai

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ── File Storage ──────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (only needed if STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=talentiq-files
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── AI / LLM ──────────────────────────────────────────────────
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (optional fallback)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local LLM — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@talentiq.ai
ADMIN_PASSWORD=Admin@123!Change_This
